# geish.no v2 — miljøvariabler (EKSEMPEL)
#
# Kopier til .env.local og fyll inn faktiske verdier. .env.local er gitignored
# og skal ALDRI committes. Prod-verdier settes i Vercel.

# ── Supabase (klient + auth) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# ── Database (Drizzle) ──────────────────────────────────────
# DATABASE_URL: Transaction pooler (port 6543), appen bruker denne (prepare:false).
# DIRECT_URL:   Session pooler (port 5432), drizzle-kit krever denne.
DATABASE_URL=
DIRECT_URL=

# ── Admin (E4.5) ────────────────────────────────────────────
# ADMIN_USER_ID: Supabase auth.users-UUID for den som er admin.
# Én autoritativ admin-identitet (D1: env, ikke role-kolonne). Fail closed:
# er denne tom, er INGEN admin. Aldri committet.
ADMIN_USER_ID=
